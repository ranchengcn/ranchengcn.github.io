{% include i18n.liquid %}
{% if site.footer_fixed %}
  <footer class="fixed-bottom" role="contentinfo">
    <div class="container mt-0">
      &copy; {{ t.copyright }}
      {{ site.time | date: '%Y' }}
      {% if current_lang == 'zh-CN' -%}
        {{- site.chinese_name -}}
      {%- else -%}
        {{- site.first_name }}
        {{ site.middle_name }}
        {{ site.last_name -}}
      {%- endif -%}
      . {{ site.footer_text }}
      {% if site.impressum_path %}
        <a href="{{ site.url }}{{ site.baseurl }}{{ site.impressum_path }}">Impressum</a>.
      {% endif %}
      {% if site.last_updated %}
        {{ t.last_updated }}: {{ 'now' | date: t.long_date_format }}.
      {% endif %}
    </div>
  </footer>
{% else %}
  <footer class="sticky-bottom mt-5" role="contentinfo">
    {% if site.newsletter.enabled %}
      {% include newsletter.liquid %}
    {% endif %}

    <div class="container">
      &copy; {{ t.copyright }}
      {{ site.time | date: '%Y' }}
      {% if current_lang == 'zh-CN' -%}
        {{- site.chinese_name -}}
      {%- else -%}
        {{- site.first_name }}
        {{ site.middle_name }}
        {{ site.last_name -}}
      {%- endif -%}
      . {{ site.footer_text }}
      {% if site.impressum_path %}
        <a href="{{ site.url }}{{ site.baseurl }}{{ site.impressum_path }}">Impressum</a>.
      {% endif %}
      {% if site.last_updated %}
        {{ t.last_updated }}: {{ 'now' | date: t.long_date_format }}.
      {% endif %}
    </div>
  </footer>
{% endif %}
