{% include i18n.liquid %}
{% if site.bib_search %}
  <script src="{{ '/assets/js/bibsearch.js' | relative_url | bust_file_cache }}" type="module"></script>
  <div class="bibliography-search">
    <input
      type="text"
      id="bibsearch"
      spellcheck="false"
      autocomplete="off"
      class="search bibsearch-form-input"
      placeholder="{{ t.filter }}"
      aria-label="{{ t.filter }}"
    >
  </div>
{% endif %}
