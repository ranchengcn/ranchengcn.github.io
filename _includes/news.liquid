{% include i18n.liquid %}
<div class="news">
  {% assign news = site.news %}
  {% if current_lang == 'zh-CN' %}{% assign news = site.news_zh %}{% endif %}
  {% if include.limit %}
    {% assign news = news | where_exp: 'item', 'item.homepage != false' %}
  {% endif %}
  {% assign news = news | sort: 'date' | reverse %}
  {% assign news_size = news | size %}
  {% if news_size > 0 %}
    {% assign news_limit = news_size %}
    {% if include.limit %}
      {% assign news_limit = site.announcements.limit | default: 5 %}
    {% endif %}
    <div class="table-responsive">
      <table class="table table-sm table-borderless">
        {% for item in news limit: news_limit %}
          {% include news_row.liquid item=item %}
        {% endfor %}
      </table>
    </div>
    {% if include.limit and news_size > news_limit %}
      <p><a href="{{ home_url | append: 'news/' | relative_url }}">{{ t.news_view_more }}</a></p>
    {% endif %}
  {% else %}
    <p>{{ t.empty_news }}</p>
  {% endif %}
</div>
