{% include i18n.liquid %}
<div class="news">
  {% assign news = site.news %}
  {% if current_lang == 'zh-CN' %}{% assign news = site.news_zh %}{% endif %}
  {% if news != blank %}
    {% if include.limit %}
      {% assign news = news | where_exp: 'item', 'item.homepage != false' %}
    {% endif %}
    {% assign news_size = news | size %}
    <div
      class="table-responsive"
      {% if include.limit and site.announcements.scrollable and news_size > 3 %}
        style="max-height: 60vw"
      {% endif %}
    >
      <table class="table table-sm table-borderless">
        {% assign news = news | reverse %}
        {% if include.limit and site.announcements.limit %}
          {% assign news_limit = site.announcements.limit %}
        {% else %}
          {% assign news_limit = news_size %}
        {% endif %}
        {% for item in news limit: news_limit %}
          <tr>
            <th scope="row" style="width: 20%">{{ item.date | date: t.date_format }}</th>
            <td>
              {% if item.inline %}
                {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
              {% else %}
                <a class="news-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
              {% endif %}
            </td>
          </tr>
        {% endfor %}
      </table>
    </div>
  {% else %}
    <p>{{ t.empty_news }}</p>
  {% endif %}
</div>
