{% include i18n.liquid %}
<div class="news">
  {% assign news = site.news %}
  {% if current_lang == 'zh-CN' %}{% assign news = site.news_zh %}{% endif %}
  {% assign archive_size = news | size %}
  {% if include.limit %}
    {% assign news = news | where_exp: 'item', 'item.homepage != false' %}
  {% endif %}
  {% assign news = news | sort: 'date' | reverse %}
  {% assign news_size = news | size %}
  {% assign news_limit = news_size %}
  {% if include.limit %}
    {% assign news_limit = site.announcements.limit | default: 5 %}
    <div class="news-heading">
      <h2>
        <a href="{{ home_url | append: 'news/' | relative_url }}">{{ t.news }}</a>
      </h2>
      {% assign visible_news = news_size | at_most: news_limit %}
      {% if archive_size > visible_news %}
        <a class="news-more" href="{{ home_url | append: 'news/' | relative_url }}">
          {{- t.news_view_more }}
          <span aria-hidden="true">→</span></a
        >
      {% endif %}
    </div>
  {% endif %}
  {% if news_size > 0 %}
    <div class="table-responsive">
      <table class="table table-sm table-borderless">
        {% for item in news limit: news_limit %}
          {% include news_row.liquid item=item %}
        {% endfor %}
      </table>
    </div>
  {% else %}
    <p>{{ t.empty_news }}</p>
  {% endif %}
</div>
