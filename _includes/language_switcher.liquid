{% if page.translation_key %}
  {% assign documents = site.pages | concat: site.news | concat: site.news_zh %}
  {% assign translations = documents | where: 'translation_key', page.translation_key | sort: 'lang' %}
  <li class="nav-item language-switcher">
    <div class="language-options" role="group" aria-label="{{ t.choose_language }}">
      {% for translation in translations %}
        {% if translation.lang == 'zh-CN' %}
          {% assign language_label = '中文' %}
          {% assign language_name = '简体中文' %}
        {% else %}
          {% assign language_label = 'EN' %}
          {% assign language_name = 'English' %}
        {% endif %}
        {% unless forloop.first -%}
          <span class="language-divider" aria-hidden="true">/</span>
        {%- endunless %}
        {% if translation.lang == current_lang %}
          <span class="language-option is-current" lang="{{ translation.lang }}" aria-current="true" title="{{ language_name }}">
            {{- language_label -}}
          </span>
        {% else %}
          <a
            class="language-option"
            href="{{ translation.url | relative_url }}"
            lang="{{ translation.lang }}"
            hreflang="{{ translation.lang }}"
            aria-label="{{ language_name }}"
            title="{{ language_name }}"
          >
            {{- language_label -}}
          </a>
        {% endif %}
      {% endfor %}
    </div>
  </li>
{% endif %}
